@page "/danh-sach-game"
@using AntDesign
@using GameManagement.CoreConfig.Extensions;
@using GameManagement.Share.Extension
@using GameManagement.Share.Model.ViewModel;
@using GameManagement.SpecialComponent;
@using Microsoft.AspNetCore.Components.Routing
@using static GameManagement.Share.Extension.MessageEnumExtension


<AntDesign.Row Gutter="8">
    <AntDesign.Col Span="24">
        <AntDesign.Title Level="3">Danh sách game</AntDesign.Title>
    </AntDesign.Col>
    <AntDesign.Col Span="24">
        <Row Gutter="8">
            <Space>
                <SpaceItem>
                    <Button Icon="plus" OnClick="@AddNewGame" Type="@ButtonType.Primary" Color="Color.Green7">Thêm mới</Button>
                </SpaceItem>
            </Space>
        </Row>
    </AntDesign.Col>
    <AntDesign.Col Span="24">
        <Table TItem="GameViewModel"
               DataSource="ViewModels"
               ScrollX="1480px"
               ScrollY="calc(100vh - 260px)"
               ScrollBarWidth="@DefaultTableConfig.ScrollBarWidth"
               Loading="loading"
               OnRowClick="OnRowClick"
               @ref="Table">

            <Column @bind-Field="context.Stt"
                    Title="STT" Fixed="ColumnFixPlacement.Left"
                    Width="60">
            </Column>

            <Column @bind-Field="context.Name"
                    Title="Tên game" Fixed="ColumnFixPlacement.Left"
                    Width="200">
            </Column>

            <Column @bind-Field="context.GameCompanyName"
                    Title="Hãng game"
                    Width="150">
            </Column>

            <Column @bind-Field="context.Status"
                    Title="Trạng thái"
                    Width="120">
                <Template>
                    @CommonTemplate.RenderGameStatusText(context.Status)
                </Template>
            </Column>

            <Column @bind-Field="context.SoldStatus"
                    Title="Trạng thái bán"
                    Width="120">
                <Template>
                    @CommonTemplate.RenderGameSoldStatusText(context.SoldStatus)
                </Template>
            </Column>

            <Column @bind-Field="context.ReleaseStatus"
                    Title="Trạng thái phát hành"
                    Width="150">
                    <Template>
                        @CommonTemplate.RenderGameReleaseStatusText(context.ReleaseStatus)
                    </Template>
            </Column>

            <Column Field="@context.DisplayPrice"
                    Title="Giá gốc"
                    Width="130">
            </Column>

            <Column Field="@context.CurrentSalePercent"
                    Width="140">
                <TitleTemplate>
                    <Tooltip Title="Sẽ căn cứ theo giảm giá theo thời gian bên thiết lập, nếu không có mặc định là 0">
                        <span>
                            Giảm hiện tại (%)
                            <Icon Type="info-circle" />
                        </span>
                    </Tooltip>
                </TitleTemplate>
            </Column>

            <Column Field="@context.CurrentPrice"
                    Width="130">
                <TitleTemplate>
                    <Tooltip Title="Giá hiện tại = Giá gốc * (100 - N%)/100">
                        <span>
                            Giá hiện tại
                            <Icon Type="info-circle" />
                        </span>
                    </Tooltip>
                </TitleTemplate>
            </Column>

            <Column @bind-Field="context.IsFeatured"
                    Title="Game nổi bật"
                    Width="130">
                <Template>
                    <Badge Count="@(context.OrderFeatured ?? 0)">
                        @if (context.IsFeatured)
                        {
                            <Tag>Có</Tag>
                        }
                        else
                        {
                            <Tag>Không</Tag>
                        }
                    </Badge>
                </Template>
            </Column>

            <ActionColumn Title="Thao tác"
                          Width="130">
                <Space Size="SpaceSize.Small">
                    <SpaceItem>
                        <Tooltip Title="Chi tiết">
                            <Button Type="ButtonType.Text"
                                    Size="ButtonSize.Default" Color="Color.Blue2"
                                    OnClick="() => ViewDetailAsync(context)">
                                <Icon Type="eye" />
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="Xóa">
                                <Button Type="ButtonType.Text" Danger
                                        Size="ButtonSize.Default"
                                        OnClick="() => DeleteGameAsync(context)">
                                    <Icon Type="delete" />
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                  
                </Space>
            </ActionColumn>

        </Table>

    </AntDesign.Col>
</AntDesign.Row>

<Drawer Width="@width.ToString()" ZIndex="1000"
        Height="@height.ToString()"
        Visible="createVisible"
        Title="@title"
        OnClose="CloseDetailGame"
        MaskClosable="false">
    <GameDetail @ref="gameDetailRef" ReSize="ReSize" CompanyDatas="CompanyDatas" GameTypeDatas="GameTypeDatas"
                OnCancel="CloseDetailGame" ReloadGameData="LoadDataAsync" TotalCurrentFeatureGame="@totalFeature" FeatureDatas="FeatureGameDatas">

    </GameDetail>
</Drawer>