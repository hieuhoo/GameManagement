@page "/danh-sach-binh-luan"
@using AntDesign
@using GameManagement.CoreConfig.Extensions
@using GameManagement.Share.Extension
@using GameManagement.Share.Model.ViewModel;
@using static GameManagement.Share.Extension.EnumExtension

<AntDesign.Row Gutter="8">
    <AntDesign.Col Span="24">
        <AntDesign.Title Level="3">Danh sách bình luận đánh giá</AntDesign.Title>
    </AntDesign.Col>

    <AntDesign.Col Span="24">
        <Table TItem="UserGameReviewViewModel"
               DataSource="ViewModels"
               ScrollY="calc(100vh - 260px)"
               ScrollBarWidth="@DefaultTableConfig.ScrollBarWidth"
               Loading="loading"
               OnRowClick="OnRowClick"
               @ref="Table">

            <PropertyColumn Property="context => context.Stt"
                            Title="STT" Fixed="ColumnFixPlacement.Left"
                            Width="70">
            </PropertyColumn>

            <PropertyColumn Property="context => context.GameName"
                            Title="Tên game" Fixed="ColumnFixPlacement.Left" Ellipsis="true"
                            Width="130">
            </PropertyColumn>

            <PropertyColumn Property="context => context.Comment"
                            Title="Nội dung bình luận"
                            Width="230">
                <Space>
                    <Typography Ellipsis="true">
                        @context.Comment
                    </Typography>

                    <AntDesign.Tooltip Title="Xem lịch sử">
                        <Icon Type="eye"
                              Theme="IconThemeType.TwoTone"
                              OnClick="() => ViewHistoryComment(context.Id)" />
                    </AntDesign.Tooltip>
                </Space>
            </PropertyColumn>

            <PropertyColumn Property="context => context.ReplyCount"
                            Title="Số lượt phản hồi"
                            Width="160">

                <div class="sale-count-cell">
                    <span>@context.ReplyCount</span>
                    <AntDesign.Tooltip Title="Xem chi tiết phản hồi">
                        <span class="sale-history-icon">
                            <Icon Type="eye"
                                  Theme="IconThemeType.TwoTone"
                                  OnClick="() => OpenReplyForCommentAsync(context)" />
                        </span>
                    </AntDesign.Tooltip>
                </div>
            </PropertyColumn>

            <PropertyColumn Property="context => context.CreateDate.GetFormatDateWithSecond()"
                            Title="Ngày tạo bình luận"
                            Width="160">
            </PropertyColumn>


            <PropertyColumn Property="context => context.LikeCount"
                            Title="Số lượt Like" Align="ColumnAlign.Right"
                            Width="80">

                <div class="sale-count-cell">
                    <span>@context.LikeCount</span>
                    <AntDesign.Tooltip Title="Xem danh sách tương tác">
                        <span class="sale-history-icon">
                            <Icon Type="eye"
                                  Theme="IconThemeType.TwoTone"
                                  OnClick="() => OpenListUsersReaction(TypeReaction.Like.ToString(), context.Id)" />
                        </span>
                    </AntDesign.Tooltip>
                </div>

            </PropertyColumn>

            <PropertyColumn Property="context => context.HeartCount"
                            Title="Số lượt tym"
                            Width="80">
                <div class="sale-count-cell">
                    <span>@context.HeartCount</span>
                    <AntDesign.Tooltip Title="Xem danh sách tương tác">
                        <span class="sale-history-icon">
                            <Icon Type="eye"
                                  Theme="IconThemeType.TwoTone"
                                  OnClick="() => OpenListUsersReaction(TypeReaction.Heart.ToString(), context.Id)" />
                        </span>
                    </AntDesign.Tooltip>
                </div>
            </PropertyColumn>

            <PropertyColumn Property="context => context.FunnyCount"
                            Title="Số lượt haha"
                            Width="80">
                <div class="sale-count-cell">
                    <span>@context.FunnyCount</span>
                    <AntDesign.Tooltip Title="Xem danh sách tương tác">
                        <span class="sale-history-icon">
                            <Icon Type="eye"
                                  Theme="IconThemeType.TwoTone"
                                  OnClick="() => OpenListUsersReaction(TypeReaction.Funny.ToString(), context.Id)" />
                        </span>
                    </AntDesign.Tooltip>
                </div>
            </PropertyColumn>

            <PropertyColumn Property="context => context.TotalReaction"
                            Title="Tổng số cảm xúc"
                            Width="100">
                <div class="sale-count-cell">
                    <span>@context.TotalReaction</span>
                </div>
            </PropertyColumn>

            <PropertyColumn Property="context => context.IsAnonymous"
                            Title="Trạng thái ẩn danh"
                            Width="110">
                <Template>
                    @if (context.IsAnonymous == true)
                    {
                        <span>Ẩn danh</span>
                    }
                    else
                    {
                        <span>Công khai</span>
                    }
                </Template>
            </PropertyColumn>

            <PropertyColumn Property="context => context.IsHidden"
                            Title="Trạng thái ẩn/hiện"
                            Width="130">
                <Template>
                    @if (context.IsHidden == true)
                    {
                        <span style="color:red;">Đang bị ẩn</span>
                    }
                    else
                    {
                        <span style="color:limegreen;">Đang hiển thị</span>
                    }
                </Template>
            </PropertyColumn>

            <PropertyColumn Property="context => context.HideReason"
                            Title="Lí do ẩn"
                            Width="150">
                <Space>
                    <Typography Ellipsis="true">
                        @context.HideReason
                    </Typography>
                </Space>
            </PropertyColumn>

            <ActionColumn Title="Thao tác"
                          Width="80" Fixed="ColumnFixPlacement.Right">
                <Space Size="SpaceSize.Small">
                    <SpaceItem>
                        <Tooltip Title="@(context.IsHidden ? "Hiện bình luận" : "Ẩn bình luận")">
                            <Button Type="ButtonType.Text"
                                    Size="ButtonSize.Default" OnClick="() => OpenPopupConfirmHideAsync(context.Id, context.IsHidden)">
                                <Icon Type="@(context.IsHidden ? "eye-invisible" : "message")" />
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </AntDesign.Col>
</AntDesign.Row>

<Modal Title="@titleText"
       @bind-Visible="showUserReaction"
       OnCancel="CloseFormUser"
       CancelText="@cancelText">

    <AntDesign.Col Span="24">
        <Table TItem="ReactionPersonInfoViewModel"
               DataSource="ReactionViewModels"
               ScrollY="calc(100vh - 260px)"
               ScrollBarWidth="@DefaultTableConfig.ScrollBarWidth"
               Loading="personLoading"
               @ref="PersonTable">

               
            <PropertyColumn Property="context => context.Stt"
                            Title="STT"
                            Width="50">
            </PropertyColumn>

            <PropertyColumn Property="context => context.UserName"
                            Title="Người tương tác"
                            Width="200">
            </PropertyColumn>

            <PropertyColumn Property="context => context.CreateDate.GetFormatDateWithSecond()"
                            Title="Thời gian"
                            Width="150">
            </PropertyColumn>

        </Table>
    </AntDesign.Col>

</Modal>

<Modal Title="@replyTextTitle"
       @bind-Visible="showReplyList"
       OnCancel="CloseFormReplyHistory" Width="1000"
       CancelText="@cancelText">

    <AntDesign.Col Span="24">
        <Table TItem="UserGameReviewReplyViewModel"
               DataSource="ReplyViewModels"
               ScrollY="calc(100vh - 260px)"
               ScrollBarWidth="@DefaultTableConfig.ScrollBarWidth"
               Loading="replyLoading"
               @ref="ReplyTable">

               
            <PropertyColumn Property="context => context.Stt"
                            Title="STT"
                            Width="60">
            </PropertyColumn>

            <PropertyColumn Property="context => context.ReplyContent"
                            Title="Nội dung"
                            Width="200">

                            <Space>
                                <Typography Ellipsis="true">
                                    @context.ReplyContent
                                </Typography>
                            </Space>
            </PropertyColumn>

            <PropertyColumn Property="context => context.CreateDate.GetFormatDateWithSecond()"
                            Title="Thời gian"
                            Width="150">
            </PropertyColumn>

            <PropertyColumn Property="context => context.UserName"
                            Title="Người phản hồi"
                            Width="150">
            </PropertyColumn>

        </Table>
    </AntDesign.Col>

</Modal>

<Modal Title="Ẩn bình luận"
       @bind-Visible="showHideCommentForm"
       OnCancel="CloseHideCommentFormUser"
       OnOk="ConfirmHideCommentAsync"
       OkText="@hideText"
       CancelText="@cancelText">

    <AntDesign.Col Span="24">
        <div class="mb-2">
            <span>
                Nhập lý do <span style="color:red;">(*)</span>
            </span>

            <AntDesign.TextArea @bind-Value="hideReason"
                                Rows="4"
                                MaxLength="500"
                                ShowCount
                                Placeholder="Nhập đi chờ cl" />
            @if (isRequired)
            {
                <span style="color:red;">
                    Chưa nhập lý do ẩn lày
                </span>
            }
        </div>
    </AntDesign.Col>

</Modal>

<Modal Title="@historyTitle"
       Visible="@historyVisible"
       Width="600"
       OnCancel="@CloseHistoryModal">
    <div style="max-height:60vh; overflow-y:auto;">
        <Timeline>
            Bình luận này của : @commentPerson
            <br />
            @foreach (var item in RevHistoryDatas)
            {
                bool isFirstTime = item.PrevComment.IsNullOrEmpty();
                <TimelineItem Color="@(isFirstTime ? "orange" : "green")">
                    <Space Direction="SpaceDirection.Vertical">

                        <Text Strong>
                            @(string.IsNullOrEmpty(item.PrevComment)
                                ? "Đã tạo bình luận lần đầu"
                                : "Thay đổi bình luận")
                        </Text>

                        @if (!string.IsNullOrEmpty(item.PrevComment))
                        {
                            <Text>
                                Nội dung cũ:
                            </Text>

                            <Paragraph>
                                @item.PrevComment
                            </Paragraph>
                        }

                        <Text>
                            @(string.IsNullOrEmpty(item.PrevComment)
                                ? "Nội dung:"
                                : "Nội dung mới:")
                        </Text>

                        <Paragraph>
                            @item.CurrentComment
                        </Paragraph>


                        <Text Type="TextElementType.Secondary">
                            @(string.IsNullOrEmpty(item.PrevComment)
                           ?  $" Tạo mới lúc {@item.CreateDate.ToString("dd/MM/yyyy HH:mm")}"
                           : $" Thay đổi lúc {@item.CreateDate.ToString("dd/MM/yyyy HH:mm")}")
                        </Text>

                    </Space>
                </TimelineItem>
            }
        </Timeline>
    </div>

</Modal>