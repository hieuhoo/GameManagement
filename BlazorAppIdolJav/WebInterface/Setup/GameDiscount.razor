@using AntDesign
@using GameManagement.CoreConfig
@using GameManagement.Share.Extension
@using GameManagement.Share.Model.ViewModel
@using GameManagement.SpecialComponent
@using GameManagement.SpecialComponent.ExtensionClass
@using static GameManagement.Share.Extension.MessageEnumExtension
@using Microsoft.AspNetCore.Components.Forms
@using GameManagement.CoreConfig.Extensions
@using GameManagement.Share.ClassData


<Row Gutter="8">
    <AntDesign.Col Span="14">
        <Table TItem="GameDiscountViewModel" DataSource="ViewModels"
               Class="table-striped" ScrollY="@ScrollY" ScrollBarWidth="@DefaultTableConfig.ScrollBarWidth"
               Loading="loading"
               OnRowClick="OnRowClick"
               @ref="table">
            <Column @bind-Field="context.Stt" Width="60" Title="Stt"></Column>
            <Column @bind-Field="context.GameName" Title="Tên game" Ellipsis></Column>
            <Column @bind-Field="context.DiscountPercent" Title="% giảm" Width="150"></Column>
            <Column @bind-Field="context.StartDate" Title="Thời gian bắt đầu" Width="130"></Column>
            <Column @bind-Field="context.EndDate" Title="Thời gian kết thúc" Width="130"></Column>
                
        </Table>
    </AntDesign.Col>
    <AntDesign.Col Span="10">
        <Row Gutter="8">
            <Space Size="@SpaceSize.Small">
                @if (EditModel.ReadOnly)
                {
                    <SpaceItem><Button OnClick="Add" Type="@ButtonType.Primary" Color="Color.Green7" Icon="plus">Thêm mới</Button></SpaceItem>
                    @if (SelectModel != null)
                    {
                        <SpaceItem><Button OnClick="Edit" Type="@ButtonType.Primary" Icon="edit">Sửa</Button></SpaceItem>
                    }
                }
                @if (!EditModel.ReadOnly)
                {
                    <SpaceItem>
                        <Button OnClick="SaveAsync" Type="@ButtonType.Primary" Color="Color.Green7" Icon="save">Lưu</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm OnConfirm="() => Cancel()"
                                    OkText="Đồng ý"
                                    CancelText="Hủy">
                            <ChildContent>
                                <Button Icon="close" Type="@ButtonType.Primary" Danger>Hủy</Button>
                            </ChildContent>
                            <TitleTemplate>
                                @OperationEnum.AreYouSureCancel.GetDescription()
                            </TitleTemplate>
                        </Popconfirm>
                    </SpaceItem>
                }
                @if (EditModel.ReadOnly)
                {
                    @if (SelectModel != null)
                    {
                        <SpaceItem>
                            <Popconfirm Placement="@Placement.LeftBottom"
                                        OnConfirm="() => DeleteAsync(SelectModel)"
                                        OkText="Đồng ý"
                                        CancelText="Hủy">
                                <ChildContent>
                                    <Button Class="btn-delete" Type="@ButtonType.Primary" Danger Icon="delete">Xóa</Button>
                                </ChildContent>
                                <TitleTemplate>
                                    @OperationEnum.AreYouSureToDelete.GetDescription()
                                </TitleTemplate>
                            </Popconfirm>
                        </SpaceItem>
                    }
                }
            </Space>
        </Row>
        <Row Gutter="8">
            <AntDesign.Col Span="24">
                <EditForm Model="EditModel">
                    <DataAnnotationsValidator />
                    <InputWatcher @ref="inputWatcher"></InputWatcher>
                    <Row Gutter="8">
                        <AntDesign.Col Span="12">
                            <LabelFor For="() => EditModel.GameId"></LabelFor>
                            <Select TItemValue="string" TItem="GameData" EnableSearch
                                    DataSource="GameDatas"
                                    LabelName="@nameof(GameCompanyData.Name)"
                                    ValueName="@nameof(GameCompanyData.Id)"
                                    AllowClear
                                    @bind-Value="EditModel.GameId" Disabled="EditModel.ReadOnly">
                            </Select>
                            <ValidationMessage For="() => EditModel.GameId"></ValidationMessage>
                        </AntDesign.Col>

                        <AntDesign.Col Span="12">
                            <LabelFor FieldIdentifier="context.Field(EditModel.Property.NameProperty(c => c.DiscountPercent))"></LabelFor>
                            <Input Type="@InputType.Number" @bind-Value="@EditModel.DiscountPercent" Disabled="@EditModel.ReadOnly" Placeholder="">
                            <ValidationMessage For="() => EditModel.DiscountPercent"></ValidationMessage>
                        </AntDesign.Col>
                    </Row>
                    <Row Gutter="8">
                        <AntDesign.Col Span="12">

                            <LabelFor FieldIdentifier="context.Field(EditModel.Property.NameProperty(c => c.StartDate))"></LabelFor>
                            <br>
                            <DatePicker @bind-Value="@EditModel.StartDate"
                                        Disabled="@EditModel.ReadOnly"
                                        Style="display:block"
                                        ShowTime="true"
                                        ChangeOnClose>
                            </DatePicker>
                            <ValidationMessage For="() => EditModel.StartDate"></ValidationMessage>
                        </AntDesign.Col>

                        <AntDesign.Col Span="12">
                            <LabelFor FieldIdentifier="context.Field(EditModel.Property.NameProperty(c => c.EndDate))"></LabelFor>
                            <br>
                            <DatePicker @bind-Value="@EditModel.EndDate"
                                        Disabled="@EditModel.ReadOnly"
                                        Style="display:block"
                                        ShowTime="true"
                                        ChangeOnClose>
                            </DatePicker>
                            <ValidationMessage For="() => EditModel.EndDate"></ValidationMessage>
                        </AntDesign.Col>
                    </Row>

                    <AntDesign.Col Span="24">
                        <LabelFor FieldIdentifier="context.Field(EditModel.Property.NameProperty(c => c.Status))"></LabelFor>
                        <Select TItemValue="string" TItem="SelectItem" EnableSearch
                                DataSource="StatusOptions"
                                LabelName="@nameof(SelectItem.Text)"
                                ValueName="@nameof(SelectItem.Value)"
                                @bind-Value="EditModel.Status" Disabled="EditModel.ReadOnly">
                        </Select>
                        <ValidationMessage For="() => EditModel.Status"></ValidationMessage>
                    </AntDesign.Col>
                </EditForm>
            </AntDesign.Col>
        </Row>
    </AntDesign.Col>
</Row>

