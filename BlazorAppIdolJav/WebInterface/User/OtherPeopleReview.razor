@using AntDesign
@using GameManagement.CoreConfig.Extensions;
@using GameManagement.Share.Extension
@using static GameManagement.Share.Extension.EnumExtension;

<Modal Title="@reviewModalTitle"
       @bind-Visible="isShowCommentVisible"
       Width="900"
       OnCancel="CloseFormReview"
       Footer="@null">

    <div class="review-modal-body">

        @if (reviewLoading)
        {
            <AntDesign.Row Justify="RowJustify.Center">
                <AntDesign.Col>
                    <Spin />
                </AntDesign.Col>
            </AntDesign.Row>
        }
        else
        {
            <!-- =========================
                 REVIEW SUMMARY
                 ========================= -->
            <AntDesign.Row Gutter="(24, 16)"
                           Align="RowAlign.Middle">

                <!-- Average -->
                <AntDesign.Col Xs="24" Md="12">

                    <div class="review-summary">

                        <div class="review-summary-title">
                            Đánh giá trung bình của người chơi
                        </div>

                        <div class="review-summary-average">

                            <div class="average-star">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor(reviewStatisticData.AverageStarNumber))
                                    {
                                        <span class="star active">
                                            ★
                                        </span>
                                    }
                                    else if (i == Math.Ceiling(reviewStatisticData.AverageStarNumber)
                                             && reviewStatisticData.AverageStarNumber % 1 != 0)
                                    {
                                        <span class="star half">

                                            <span class="star-half-gray">
                                                ★
                                            </span>

                                            <span class="star-half-yellow">
                                                ★
                                            </span>

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="star">
                                            ★
                                        </span>
                                    }
                                }
                            </div>

                            <div class="average-score-line">

                                <span class="average-score">
                                    @reviewStatisticData.AverageStarNumber.ToString("0.#")
                                </span>

                                <span class="average-max">
                                    / 5
                                </span>

                            </div>

                        </div>

                        <div class="review-total">
                            <b>@reviewStatisticData.Total</b> đánh giá
                            @if (totalHiddenReviews > 0)
                            {
                                <span class="hidden-review-count">
                                    , <b>@totalHiddenReviews</b> đã bị ẩn
                                </span>
                            }
                        </div>

                    </div>

                </AntDesign.Col>


                <!-- Positive / Negative -->
                <AntDesign.Col Xs="24" Md="12">

                    <AntDesign.Row Gutter="(8, 12)">

                        <AntDesign.Col Span="24">

                            <AntDesign.Row Justify="RowJustify.SpaceBetween">

                                <AntDesign.Col>
                                    <span>
                                        Đánh giá tích cực
                                    </span>
                                </AntDesign.Col>

                                <AntDesign.Col>
                                    <b>
                                        @reviewStatisticData.QuantityPositive (@reviewStatisticData.PositivePercent.ToString("0.#")%)
                                    </b>
                                </AntDesign.Col>

                            </AntDesign.Row>

                        </AntDesign.Col>

                        <AntDesign.Col Span="24">

                            <AntDesign.Row Justify="RowJustify.SpaceBetween">

                                <AntDesign.Col>
                                    <span>
                                        Đánh giá tiêu cực
                                    </span>
                                </AntDesign.Col>

                                <AntDesign.Col>
                                    <b>
                                        @reviewStatisticData.QuantityNegative (@reviewStatisticData.NegativePercent.ToString("0.#")%)
                                    </b>
                                </AntDesign.Col>

                            </AntDesign.Row>

                        </AntDesign.Col>

                    </AntDesign.Row>

                </AntDesign.Col>

            </AntDesign.Row>


            <Divider />


            <!-- =========================
                 FILTER
                 ========================= -->
            <AntDesign.Row Justify="RowJustify.SpaceBetween"
                           Align="RowAlign.Middle"
                           Gutter="(16, 16)">

                <AntDesign.Col>

                    <RadioGroup TValue="string" @bind-Value="CurrentFilter"
                                OnChange="OnFilterChanged">

                        <Radio Value="ReviewFilter.All.ToString()">
                            @ReviewFilter.All.GetDescription()
                        </Radio>

                        <Radio Value="ReviewFilter.Positive.ToString()">
                            @ReviewFilter.Positive.GetDescription()

                        </Radio>

                        <Radio Value="ReviewFilter.Negative.ToString()">
                            @ReviewFilter.Negative.GetDescription()
                        </Radio>

                    </RadioGroup>

                </AntDesign.Col>

                <AntDesign.Col>

                    <span class="review-count">

                        @totalDisplayReviews đánh giá

                    </span>

                </AntDesign.Col>

            </AntDesign.Row>


            <Divider />


            <!-- =========================
                 REVIEW LIST
                 ========================= -->
            @if (!PagedReviews.Any())
            {
                <Empty />
            }
            else
            {
                <div class="review-list-scroll">
                    @foreach (var review in PagedReviews)
                    {
                        <Card Class="review-item-card">

                            <!-- USER -->
                            <AntDesign.Row Justify="RowJustify.SpaceBetween"
                                           Align="RowAlign.Middle">

                                <AntDesign.Col>

                                    <Space Align="SpaceAlign.Center">
                                        @* //case ẩn danh ko hiện bình luận *@
                                        <Avatar>
                                            @GetUserInitial(review.UserName, review.IsAnonymous)
                                        </Avatar>

                                        <div>

                                            <div class="review-user-name">
                                                <b>
                                                    @(review.IsAnonymous ? "Người dùng ẩn danh" : review.UserName)
                                                </b>
                                            </div>

                                            <div class="review-date">
                                                @review.CreateDate
                                            </div>

                                        </div>

                                    </Space>

                                </AntDesign.Col>


                                <!-- Edit own review -->
                                @if (review.UserId == currentUserId)
                                {
                                    <AntDesign.Col>

                                        <Button Type="ButtonType.Link" OnClick="() => EditYourReviewAsync(review.UserId, review.GameId)">
                                            <Icon Type="edit"
                                                  Theme="IconThemeType.Outline" />
                                            Chỉnh sửa bình luận của bạn

                                        </Button>

                                    </AntDesign.Col>
                                }

                            </AntDesign.Row>

                            <Divider />

                            <!-- RATING -->
                            <AntDesign.Row Align="RowAlign.Middle"
                                           Gutter="(12, 8)">

                                <AntDesign.Col>
                                    <div class="average-star">

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="star
                                                @(i <= review.StarNumber
                                                    ? "active"
                                                    : "")">
                                                ★
                                            </span>
                                        }

                                    </div>

                                </AntDesign.Col>


                                <AntDesign.Col>

                                    <span class="review-score">
                                        <b>
                                            @review.StarNumber.ToString("0.#")
                                        </b>
                                        / 5
                                    </span>

                                </AntDesign.Col>


                                <!-- Recommend -->
                                <AntDesign.Col>

                                    @if (review.IsRecommend)
                                    {
                                        <Tag>

                                            <Icon Type="like"
                                                  Theme="IconThemeType.Outline" />
                                            Đề xuất
                                        </Tag>
                                    }
                                    else
                                    {
                                        <Tag>
                                            <Icon Type="dislike"
                                                  Theme="IconThemeType.Outline" />
                                            Không đề xuất
                                        </Tag>
                                    }
                                </AntDesign.Col>

                            </AntDesign.Row>


                            <!-- COMMENT -->
                            <div class="review-comment">
                                @review.Comment
                            </div>


                            <!-- LIKE / HEART -->
                            <AntDesign.Row Gutter="4"
                                           Align="RowAlign.Top"
                                           Style="margin-top: 12px;  gap: 4px !important;">

                                <!-- LIKE -->
                                <AntDesign.Col>
                                    <Popover Trigger="@(new[] { Trigger.Hover })"
                                             Placement="Placement.Top">

                                        <ChildContent>
                                            <Button Type="ButtonType.Link"
                                                    OnClick="() => ChangeReactReviewAsync(review.Id, TypeReaction.Like.ToString(), review.UserId, review.GameId)">
                                                <Icon Type="like"
                                                      Theme="@(review.MyReaction == TypeReaction.Like.ToString()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ? IconThemeType.Fill
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        : IconThemeType.Outline)"
                                                      Style="@(review.MyReaction == TypeReaction.Like.ToString()  ? "color: dodgerblue;" : "")" />

                                                <span>
                                                    @FormatCorrectReactionCount(review.LikeCount)
                                                </span>
                                            </Button>
                                        </ChildContent>
                                        <ContentTemplate>
                                            <ReactionUserList ReactionUsers="@(review.ReactInfos
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      .Where(c => c.ReactionType == TypeReaction.Like.ToString()))"
                                                              EmptyText="Chưa có lượt thích nào" />
                                        </ContentTemplate>
                                    </Popover>
                                </AntDesign.Col>

                                <!-- HEART -->
                                <AntDesign.Col>
                                    <Popover Trigger="@(new[] { Trigger.Hover })"
                                             Placement="Placement.Top">

                                        <ChildContent>
                                            <Button Type="ButtonType.Link"
                                                    OnClick="() => ChangeReactReviewAsync(  review.Id, TypeReaction.Heart.ToString(), review.UserId, review.GameId)">
                                                <Icon Type="heart"
                                                      Theme="@(review.MyReaction == TypeReaction.Heart.ToString()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ? IconThemeType.Fill
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        : IconThemeType.Outline)"
                                                      Style="@(review.MyReaction == TypeReaction.Heart.ToString() ? "color: #ef1c1c;"  : "")" />
                                                <span>
                                                    @FormatCorrectReactionCount(review.HeartCount)
                                                </span>
                                            </Button>
                                        </ChildContent>
                                        <ContentTemplate>
                                            <ReactionUserList ReactionUsers="@(review.ReactInfos
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      .Where(c => c.ReactionType == TypeReaction.Heart.ToString()))"
                                                              EmptyText="Chưa có lượt tim nào" />
                                        </ContentTemplate>
                                    </Popover>
                                </AntDesign.Col>

                                @* Cười haha *@
                                <AntDesign.Col>
                                    <Popover Trigger="@(new[] { Trigger.Hover })"
                                             Placement="Placement.Top">

                                        <ChildContent>
                                            <Button Type="ButtonType.Link"
                                                    OnClick="() => ChangeReactReviewAsync(
                                                review.Id,
                                                TypeReaction.Funny.ToString(), review.UserId, review.GameId)">

<Icon Type="smile"
      Theme="@(review.MyReaction == TypeReaction.Funny.ToString()
                                                                                            ? IconThemeType.Fill
                                                                                            : IconThemeType.Outline)"
                                                      Style="@(review.MyReaction == TypeReaction.Funny.ToString()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ? "color: #fadb14;"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                : "")" />

                                                <span>
                                                    @FormatCorrectReactionCount(review.FunnyCount)
                                                </span>

                                            </Button>
                                        </ChildContent>

                                        <ContentTemplate>
                                            <ReactionUserList ReactionUsers="@(review.ReactInfos
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .Where(c => c.ReactionType == TypeReaction.Funny.ToString()))"
                                                              EmptyText="Chưa có lượt haha nào" />
                                        </ContentTemplate>

                                    </Popover>
                                </AntDesign.Col>
                                <!-- REPLY BUTTON -->

                                <AntDesign.Col>

                                    <Button Type="ButtonType.Link"
                                            OnClick="() => ToggleReplyBoxForOriginalComment(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    review.Id,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    review.IsAnonymous,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    GetDisplayUserName(review.UserName, review.IsAnonymous))">
Trả lời
</Button>
                                </AntDesign.Col>
                            </AntDesign.Row>
                            @* nút xem d/sách phản hồi *@
                            @if (review.RepliesData.Any())
                            {
                                <Button Type="ButtonType.Link"
                                        OnClick="() => ToggleAllReplies(review.Id)">

                                    @(expandedAllReplies.Contains(review.Id)
                                        ? "Ẩn bớt phản hồi"
                                        : $"Xem {review.RepliesData.Count} phản hồi")

                                </Button>
                            }

                            <!-- REPLY LIST -->
                            @if (expandedAllReplies.Contains(review.Id))
                            {
                                <div class="reply-container">
                                    @* check hiển thị nút xem them ... bình luận *@
                                    @foreach (var reply in review.RepliesData
                                                .Where(x => x.ParentId == null))
                                    {
                                        <div class="reply-item-wrapper">
                                            <div class="reply-item">
                                                @if (reply.IsDeleted)
                                                {
                                                    <div class="reply-deleted-content">
                                                        Bình luận này hiện không còn khả dụng hoặc đã bị ẩn
                                                    </div>
                                                }
                                                else
                                                {
                                                    <Space Align="SpaceAlign.Start">
                                                        <Avatar Size="AvatarSize.Small">
                                                            @GetUserInitial(reply.UserName, false)
                                                        </Avatar>
                                                        <div>
                                                            <div class="reply-user-info">

                                                                <b>
                                                                    @reply.UserName
                                                                </b>

                                                                <span class="reply-time">
                                                                    @DateTimeExtension.GetRelativeTime(reply.CreateDate)
                                                                </span>
                                                                @if (reply.UserId == review.UserId)
                                                                {
                                                                    <span class="edited-text" style="color:dodgerblue !important;">
                                                                        <Icon Type="edit"
                                                                              Style="font-size: 11px; margin-right: 3px;" />
                                                                        Tác giả
                                                                    </span>
                                                                }
                                                                @if ((reply.UpdatedDate - reply.CreateDate).TotalSeconds > 1)
                                                                {
                                                                    <span class="edited-text">
                                                                        Đã chỉnh sửa
                                                                    </span>
                                                                }
                                                                @if (reply.UserId == currentUserId)
                                                                {
                                                                    <Dropdown Placement="Placement.BottomRight">
                                                                        <Overlay>
                                                                            <Menu>
                                                                                <MenuItem>
                                                                                    <Button Type="ButtonType.Text" OnClick="() => EditReply(reply)">
                                                                                        <Icon Type="edit" />
                                                                                        Chỉnh sửa
                                                                                    </Button>
                                                                                </MenuItem>

                                                                                <MenuItem>
                                                                                    <Button Type="ButtonType.Text" OnClick="() => DeleteReplyAsync(reply)">
                                                                                        <Icon Type="delete" />
                                                                                        Xóa
                                                                                    </Button>
                                                                                </MenuItem>
                                                                            </Menu>

                                                                        </Overlay>

                                                                        <ChildContent>

                                                                            <Button Type="ButtonType.Text"
                                                                                    Class="reply-more-btn">
                                                                                <Icon Type="ellipsis" />
                                                                            </Button>

                                                                        </ChildContent>

                                                                    </Dropdown>
                                                                }
                                                            </div>
                                                            <div class="reply-content @(expandedReplyContent.Contains(reply.Id) ? "expanded" : "")">
                                                                @reply.ReplyContent
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(reply.ReplyContent)
                                                                    && reply.ReplyContent.Length > 120)
                                                            {
                                                                //nếu nội dung dài hiện thêm/ẩn
                                                                <Button Type="ButtonType.Link"
                                                                        Size="ButtonSize.Small"
                                                                        OnClick="() => ToggleLongReplyContent(reply.Id)">

                                                                    @(expandedReplyContent.Contains(reply.Id)
                                                                        ? "Ẩn bớt"
                                                                        : "Xem thêm")

                                                                </Button>
                                                            }
                                                            <Space Align="SpaceAlign.Center">
                                                                @* thêm icon vào đây react phản hồi level 1*@
                                                                <div class="reply-actions">
                                                                    <Button Type="ButtonType.Link"
                                                                            Size="ButtonSize.Small"
                                                                            OnClick="() => ChangeReactionReplyLevel1Async(reply)">
                                                                        <Icon Type="like"
                                                                              Theme="@(reply.IsLikedByMe
                                                                                                                                                                                                                                                                                              ? IconThemeType.Fill
                                                                                                                                                                                                                                                                                              : IconThemeType.Outline)" />

                                                                        <span>
                                                                            @FormatCorrectReactionCount(reply.LikeCount)
                                                                        </span>
                                                                    </Button>

                                                                </div>
                                                                @* -- *@
                                                                @* Nút trả lời reply *@
                                                                @if (!reply.IsDeleted && reply.UserId != currentUserId)
                                                                {
                                                                    <div class="reply-actions">

                                                                        <Button Type="ButtonType.Link"
                                                                                Size="ButtonSize.Small"
                                                                                OnClick="() => ToggleReplyBoxForOneReply(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            reply.Id,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            reply.IsAnonymous,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            reply.UserName)">
Trả lời
</Button>

                                                                    </div>
                                                                    @* phàn phản hồi về phản hồi của bình luận gốc (gọi là phản hồi level2) *@
                                                                    @if (replyingToId == reply.Id)
                                                                    {
                                                                        <div class="child-reply-input">

                                                                            <div class="child-reply-wrapper">

                                                                                <span class="reply-target">
                                                                                    @replyToUserName
                                                                                </span>

                                                                                <Input @bind-Value="replyContentLevel2"
                                                                                       OnInput="HandleInputReplyNextLevel"
                                                                                       Placeholder="Viết phản hồi..." />
                                                                                <!-- Emoji -->
                                                                                <Popover Trigger="@(new[] { Trigger.Hover })"
                                                                                         Placement="Placement.Top">
                                                                                    <ChildContent>
                                                                                        <Button Type="ButtonType.Text"
                                                                                                Class="reply-icon-btn">
                                                                                            😊
                                                                                        </Button>
                                                                                    </ChildContent>

                                                                                    <ContentTemplate>
                                                                                        <div class="emoji-picker">
                                                                                            @foreach (var emoji in Emojis)
                                                                                            {
                                                                                                <Button Type="ButtonType.Text"
                                                                                                        Class="emoji-btn"
                                                                                                        OnClick="() => AddEmojiNextLevelReply(emoji)">

                                                                                                    @emoji
                                                                                                </Button>
                                                                                            }
                                                                                        </div>
                                                                                    </ContentTemplate>
                                                                                </Popover>

                                                                                <Button Type="ButtonType.Text"
                                                                                        Class="reply-icon-btn"
                                                                                        Disabled="@string.IsNullOrWhiteSpace(replyContentLevel2)"
                                                                                        OnClick="() => SubmitReplyAsync(reply.ReviewId, false, reply.UserId)">

                                                                                    <Icon Type="send" />

                                                                                </Button>

                                                                            </div>

                                                                        </div>
                                                                    }
                                                                }
                                                            </Space>
                                                            @* DANH SÁCH PHẢN HỒI LEVEL 2 *@
                                                            @if (reply.Children != null && reply.Children.Any())
                                                            {
                                                                var totalChildReplies = reply.Children.Count;

                                                                var displayedCount =
                                                                    displayedChildReplyCount.TryGetValue(
                                                                        reply.Id,
                                                                        out var count)
                                                                        ? count
                                                                        : Math.Min(2, totalChildReplies);

                                                                <div class="child-reply-container">

                                                                    @foreach (var child in reply.Children.Take(displayedCount))
                                                                    {
                                                                        <div class="child-reply-item">

                                                                            <Avatar Size="AvatarSize.Small">
                                                                                @GetUserInitial(child.UserName, false)
                                                                            </Avatar>

                                                                            <div>

                                                                                <div class="reply-user-info">

                                                                                    <b>
                                                                                        @child.UserName
                                                                                    </b>


                                                                                    <span class="reply-time">
                                                                                        @DateTimeExtension.GetRelativeTime(child.CreateDate)
                                                                                    </span>
                                                                                    @if (child.UserId == review.UserId)
                                                                                    {
                                                                                        <span class="edited-text" style="color:dodgerblue !important;">
                                                                                            <Icon Type="edit"
                                                                                                  Style="font-size: 11px; margin-right: 3px;" />
                                                                                            Tác giả
                                                                                        </span>
                                                                                    }

                                                                                    @if ((child.UpdatedDate - child.CreateDate).TotalSeconds > 1)
                                                                                    {
                                                                                        <span class="edited-text">
                                                                                            Đã chỉnh sửa
                                                                                        </span>
                                                                                    }

                                                                                </div>


                                                                                @* <div class="reply-content-row"> *@
                                                                                <div class="reply-content">
                                                                                    @child.ReplyContent
                                                                                </div>
                                                                                @* react phản hồi level2 *@
                                                                                <div class="reply-actions">
                                                                                    <Button Type="ButtonType.Link"
                                                                                            Size="ButtonSize.Small">
                                                                                        <Icon Type="like"
                                                                                              Theme="IconThemeType.Outline" />
                                                                                        <span>
                                                                                            @FormatCorrectReactionCount(child.LikeCount)
                                                                                        </span>
                                                                                    </Button>

                                                                                </div>
                                                                                @* </div> *@
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                @* Nút xem / ẩn phản hồi level 2 *@
                                                                @if (displayedCount < totalChildReplies)
                                                                {
                                                                    var remaining = totalChildReplies - displayedCount;

                                                                    <Button Type="ButtonType.Link"
                                                                            Size="ButtonSize.Small"
                                                                            OnClick="() => ShowMoreChildReplies(
                                                                                                                                                            reply.Id,
                                                                                                                                                            totalChildReplies)">

                                                                                                                                                    @(remaining >= 2
                                                                                                                                                        ? "Xem thêm 2 phản hồi"
                                                                                                                                                        : "Xem thêm 1 phản hồi")

                                                                    </Button>
                                                                }
                                                                else if (totalChildReplies > 2)
                                                                {
                                                                    <Button Type="ButtonType.Link"
                                                                            Size="ButtonSize.Small"
                                                                            OnClick="() => HideChildReplies(reply.Id)">
                                                                        Ẩn bớt phản hồi
                                                                    </Button>
                                                                }

                                                            }

                                                            @if (editingReplyId == reply.Id)
                                                            {
                                                                <div class="reply-edit-box">
                                                                    <TextArea @bind-Value="editingReplyContent"
                                                                              AutoSize="true"
                                                                              MinRows="1"
                                                                              MaxRows="7"
                                                                              Placeholder="Chỉnh sửa phản hồi..." />
                                                                    <!-- Emoji -->
                                                                    <Popover Trigger="@(new[] { Trigger.Hover })"
                                                                             Placement="Placement.Top">
                                                                        <ChildContent>
                                                                            <Button Type="ButtonType.Text"
                                                                                    Class="reply-icon-btn">
                                                                                😊
                                                                            </Button>
                                                                        </ChildContent>
                                                                        <ContentTemplate>
                                                                            <div class="emoji-picker">
                                                                                @foreach (var emoji in Emojis)
                                                                                {
                                                                                    <Button Type="ButtonType.Text"
                                                                                            Class="emoji-btn"
                                                                                            OnClick="() => AddEmoji(emoji, true)">
                                                                                        @emoji
                                                                                    </Button>
                                                                                }
                                                                            </div>
                                                                        </ContentTemplate>
                                                                    </Popover>

                                                                    <Button Type="ButtonType.Text"
                                                                            OnClick="() => SaveEditReplyAsync(reply)">
                                                                        <Icon Type="check" />
                                                                    </Button>

                                                                    <Button Type="ButtonType.Text"
                                                                            OnClick="CancelEditReply">
                                                                        <Icon Type="close" />
                                                                    </Button>
                                                                </div>
                                                            }

                                                        </div>
                                                    </Space>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            <!-- REPLY INPUT -->
                            @if (replyingReviewId == review.Id)
                            {
                                <!-- CHOOSE IDENTITY -->
                                <div class="reply-identity-container">
                                    <span class="identity-label">
                                        Phản hồi với tư cách:
                                    </span>
                                    <RadioGroup @bind-Value="replyIsAnonymous">
                                        <Radio Value="false">
                                            <Icon Type="user" />
                                            Công khai
                                        </Radio>
                                        <Radio Value="true">
                                            <Icon Type="question-circle" />
                                            Ẩn danh
                                        </Radio>
                                    </RadioGroup>
                                </div>

                                <div class="reply-input-container">

                                    <div class="reply-input-wrapper">
                                        <!-- AVATAR + NAME -->
                                        <div class="reply-user-preview">
                                            @if (replyIsAnonymous)
                                            {
                                                <Avatar Size="AvatarSize.Small">
                                                    ?
                                                </Avatar>
                                                <span class="reply-preview-name">
                                                    Người dùng ẩn danh
                                                </span>
                                            }
                                            else
                                            {
                                                <Avatar Size="AvatarSize.Small">
                                                    @GetUserInitial(GetNameOfPersonReply(), false)
                                                </Avatar>
                                                <span class="reply-preview-name">
                                                    @GetNameOfPersonReply()
                                                </span>
                                            }
                                        </div>

                                        <div class="reply-text-area">

                                            @if (!string.IsNullOrEmpty(replyToUserName))
                                            {
                                                <span class="reply-target">
                                                    @replyToUserName
                                                </span>
                                            }
                                            <Input @bind-Value="replyContent"
                                                   OnInput="HandleInputReply"
                                                   Placeholder="Viết phản hồi..." />

                                        </div>

                                        <div class="reply-actions">
                                            <!-- Emoji -->
                                            <Popover Trigger="@(new[] { Trigger.Hover })"
                                                     Placement="Placement.Top">
                                                <ChildContent>
                                                    <Button Type="ButtonType.Text"
                                                            Class="reply-icon-btn">
                                                        😊
                                                    </Button>
                                                </ChildContent>

                                                <ContentTemplate>
                                                    <div class="emoji-picker">
                                                        @foreach (var emoji in Emojis)
                                                        {
                                                            <Button Type="ButtonType.Text"
                                                                    Class="emoji-btn"
                                                                    OnClick="() => AddEmoji(emoji, false)">
                                                                @emoji
                                                            </Button>
                                                        }
                                                    </div>
                                                </ContentTemplate>
                                            </Popover>

                                            <Button Type="ButtonType.Text"
                                                    Class="reply-icon-btn"
                                                    Disabled="@string.IsNullOrWhiteSpace(replyContent)"
                                                    OnClick="() => SubmitReplyAsync(review.Id, true, review.UserId)">
                                                <Icon Type="send" />
                                            </Button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </Card>
                    }
                </div>
                <!-- =========================
                     PAGINATION
                     ========================= -->
                <AntDesign.Row Justify="RowJustify.Center"
                               Style="margin-top: 20px;">

                    <AntDesign.Col>

                        <Pagination Current="@currentPage"
                                    PageSize="@pageSize"
                                    Total="@totalReviews"
                                    OnChange="OnPageChanged" />

                    </AntDesign.Col>

                </AntDesign.Row>
            }

        }

    </div>

</Modal>
<GameReview @ref="reviewRef"></GameReview>