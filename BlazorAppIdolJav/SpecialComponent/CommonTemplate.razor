@using AntDesign
@using GameManagement.CoreConfig.Extensions
@using GameManagement.Share.Extension
@using static GameManagement.Share.Extension.EnumExtension;
<h3>CommonTemplate</h3>
@code {
    public static RenderFragment RenderGenderText(string gender) =>@<div>
@if (gender == CharacterGender.Male.ToString())
    {
    <AntDesign.Text Copyable="false">@CharacterGender.Male.GetDescription()</AntDesign.Text>
    }
    else if (gender == CharacterGender.Female.ToString())
    {
    <AntDesign.Text Copyable="false">@CharacterGender.Female.GetDescription()</AntDesign.Text>
    }
</div>;

    public static RenderFragment RenderNationalityText(string national) =>@<div>
@if (national == National.Japan.ToString())
    {
    <AntDesign.Text Copyable="false">@National.Japan.GetDescription()</AntDesign.Text>
    }
    else if (national == National.America.ToString())
    {
    <AntDesign.Text Copyable="false">@National.America.GetDescription()</AntDesign.Text>
    }
    else if (national == National.VietNam.ToString())
    {
    <AntDesign.Text Copyable="false">@National.VietNam.GetDescription()</AntDesign.Text>
    }
    else if (national == National.Taiwan.ToString())
    {
    <AntDesign.Text Copyable="false">@National.Taiwan.GetDescription()</AntDesign.Text>
    }
    else if (national == National.China.ToString())
    {
    <AntDesign.Text Copyable="false">@National.China.GetDescription()</AntDesign.Text>
    }
</div>;

    public static RenderFragment RenderStatusText(string status) =>@<div>
@if (status == StatusEnum.Active.ToString())
    {
    <AntDesign.Text Type="@TextElementType.Success" Copyable="false">@StatusEnum.Active.GetDescription()</AntDesign.Text>
    }
    else if (status == StatusEnum.Disable.ToString())
    {
    <AntDesign.Text Type="@TextElementType.Danger" Copyable="false">@StatusEnum.Disable.GetDescription()</AntDesign.Text>
    }
</div>;

    public static RenderFragment RenderAccountStatusText(string status) => @<div>
        @if (status == AccountStatus.Active.ToString())
        {
            <AntDesign.Text Type="@TextElementType.Success">@AccountStatus.Active.GetDescription()</AntDesign.Text>
        }
        else if (status == AccountStatus.Inactive.ToString())
        {
            <AntDesign.Text Type="@TextElementType.Warning">@AccountStatus.Inactive.GetDescription()</AntDesign.Text>
        }
        else if (status == AccountStatus.Lock.ToString())
        {
            <AntDesign.Text Type="@TextElementType.Danger">@AccountStatus.Lock.GetDescription()</AntDesign.Text>
        }
    </div>;

    public static RenderFragment RenderPersonLockText(string person) => @<div>
        <AntDesign.Text Copyable="false">
            @(string.IsNullOrWhiteSpace(person)
                ? " "
                : person.GetEnumDescription<LockPerson>())
        </AntDesign.Text>
    </div>;

    public static RenderFragment RenderReasonLockText(string reason) => @<div>
        <AntDesign.Text Copyable="false">
            @(string.IsNullOrWhiteSpace(reason)
                ? " "
                : reason.GetEnumDescription<AccountLockReason>())
        </AntDesign.Text>
    </div>;

    public static RenderFragment RenderRoleAccountText(string role) => @<div>
        @if (role == UserRole.Admin.ToString())
        {
            <AntDesign.Text Copyable="false">@UserRole.Admin.GetDescription()</AntDesign.Text>
        }
        else if (role == UserRole.Normal.ToString())
        {
            <AntDesign.Text Copyable="false">@UserRole.Normal.GetDescription()</AntDesign.Text>
        }
    </div>;

}
