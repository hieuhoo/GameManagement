@using AntDesign
@using GameManagement.CoreConfig
@using GameManagement.CoreConfig.Extensions
@using GameManagement.Share.ClassData
@using GameManagement.Share.Extension
@using GameManagement.SpecialComponent
@using GameManagement.SpecialComponent.ExtensionClass
@using Microsoft.AspNetCore.Components.Forms
@using static GameManagement.Share.Extension.EnumExtension

<Modal Width="600" ZIndex="1000"
       Visible="@redeemVisible"
       Title="Thông tin mã nạp"
       OnCancel="CloseRedeemDetail"
       Footer="@null"
       MaskClosable="false">

    <EditForm Model="EditModel" Context="context" OnSubmit="SaveRedeemAsync">
        <DataAnnotationsValidator />
        <InputWatcher @ref="inputWatcher"></InputWatcher>
        @if (!EditModel.ReadOnly)
        {
            <div class="redeem-code-detail">
                <div>
                    <AntDesign.Col Span="12">
                        <LabelFor For="() => EditModel.RedeemType"></LabelFor>
                        <Select TItemValue="string" TItem="SelectItem" EnableSearch
                                DataSource="RedeemOptions"
                                LabelName="@nameof(SelectItem.Text)"
                                ValueName="@nameof(SelectItem.Value)"
                                OnSelectedItemChanged="() => ChangeRedeemType(EditModel.RedeemType)"
                                AllowClear
                                @bind-Value="EditModel.RedeemType" Disabled="EditModel.ReadOnly">
                        </Select>
                        <ValidationMessage For="() => EditModel.RedeemType"></ValidationMessage>
                    </AntDesign.Col>
                </div>
                <br />

                <div class="wrap-content">
                    <AntDesign.Row Gutter="16">
                        <AntDesign.Col Span="24">
                            <LabelFor For="() => EditModel.GenerateType"></LabelFor>
                            <RadioGroup TValue="string" @bind-Value="EditModel.GenerateType" OnChange="() => ChangeTypeGenCode(EditModel.GenerateType)">
                                <Radio Value="GenerateRedeemType.ByHand.ToString()"> @GenerateRedeemType.ByHand.GetDescription()</Radio>
                                <Radio Value="GenerateRedeemType.Auto.ToString()"> @GenerateRedeemType.Auto.GetDescription() </Radio>
                            </RadioGroup>
                        </AntDesign.Col>
                    </AntDesign.Row>
                </div>

                <br />
                <div class="wrap_content">
                    <AntDesign.Col Span="24">
                        <Text>Thông tin chi tiết</Text>
                    </AntDesign.Col>
                    <AntDesign.Row Gutter="16">
                        <AntDesign.Col Span="12">
                            @if (EditModel.GenerateType == GenerateRedeemType.ByHand.ToString())
                            {
                                <LabelFor For="() => EditModel.Code"></LabelFor>
                                <Input Type="@InputType.Text" @bind-Value="@EditModel.Code" Disabled="@EditModel.ReadOnly" Placeholder="Mã có dạng VOU-XXX">
                                <ValidationMessage For="() => EditModel.Code"> </ValidationMessage>
                            }
                            else
                            {
                                <LabelFor FieldIdentifier="context.Field(nameof(EditModel.QuantityCode))"></LabelFor>
                                <Input Type="@InputType.Number" @bind-Value="@EditModel.QuantityCode" Disabled="@EditModel.ReadOnly" Placeholder="">
                                <ValidationMessage For="() => EditModel.QuantityCode"> </ValidationMessage>
                            }
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            @if (EditModel.RedeemType == RedeemCodeType.Money.ToString())
                            {
                                <LabelFor FieldIdentifier="context.Field(nameof(EditModel.Value))"></LabelFor>
                                <Input Type="@InputType.Number" @bind-Value="@EditModel.Value" Disabled="@EditModel.ReadOnly" Placeholder="">
                                <ValidationMessage For="() => EditModel.Value"> </ValidationMessage>
                            }
                            else
                            {
                                <LabelFor For="() => EditModel.GameId"></LabelFor>
                                <Select TItemValue="string" TItem="GameData" EnableSearch
                                        DataSource="GameDatas"
                                        LabelName="@nameof(GameData.Name)"
                                        ValueName="@nameof(GameData.Id)"
                                        AllowClear
                                        @bind-Value="EditModel.GameId" Disabled="EditModel.ReadOnly">
                                </Select>
                                <ValidationMessage For="() => EditModel.GameId"></ValidationMessage>
                            }
                        </AntDesign.Col>
                        <AntDesign.Col Span="24">
                            <LabelFor FieldIdentifier="context.Field(nameof(EditModel.ExpiredDate))"></LabelFor>
                            <br>
                            <DatePicker @bind-Value="@EditModel.ExpiredDate"
                                        Disabled="@EditModel.ReadOnly"
                                        Style="display:block"
                                        ChangeOnClose>
                            </DatePicker>
                            <ValidationMessage For="() => EditModel.ExpiredDate"> </ValidationMessage>
                        </AntDesign.Col>
                    </AntDesign.Row>
                </div>
                <br />
                <AntDesign.Row Gutter="8" Justify="RowJustify.End">
                    <AntDesign.Col>
                        <Button Type="@ButtonType.Primary"
                                HtmlType="submit"
                                Loading="@saving">
                            Lưu
                        </Button>
                    </AntDesign.Col>
                    <AntDesign.Col>
                        <Button Type="@ButtonType.Default"
                                HtmlType="button"
                                OnClick="CloseRedeemDetail">
                            Hủy
                        </Button>
                    </AntDesign.Col>

                </AntDesign.Row>
            </div>
        }
        else
        {
            <AntDesign.Row Gutter="16">
                <AntDesign.Col Span="24">
                    <Text>Loại quy đổi : @(EditModel.RedeemType == RedeemCodeType.Money.ToString() ? "Tiền" : "Game")</Text>
                </AntDesign.Col>
                <br />
                <AntDesign.Col Span="24">
                    <Text>
                        Tạo : @(EditModel.GenerateType == GenerateRedeemType.ByHand.ToString() ? "Bằng tay" : "Tự động")
                    </Text>
                </AntDesign.Col>
            </AntDesign.Row>

            <br />
            <div class="wrap_content">
                <AntDesign.Col Span="24">
                    <Text>Chi tiết</Text>
                </AntDesign.Col>
                <AntDesign.Col Span="24">
                    <AntDesign.Row Gutter="16">

                        <AntDesign.Col Span="12">
                            Mã : <span style="color:red;">@EditModel.Code</span>
                        </AntDesign.Col>
                        @if (EditModel.RedeemType == RedeemCodeType.Money.ToString())
                        {
                            <AntDesign.Col Span="12">
                                Giá trị : <span style="color:red;"> @(EditModel.Value.HasValue ? EditModel.Value.Value.ToString("N0") : "")</span>
                            </AntDesign.Col>
                        }
                        else
                        {
                            <AntDesign.Col Span="12">
                                Tên game : <span style="color:red;">@EditModel.GameName </span>
                            </AntDesign.Col>
                        }
                    </AntDesign.Row>
                </AntDesign.Col>
                <AntDesign.Col Span="24">
                    <AntDesign.Row Gutter="16">
                        <AntDesign.Col Span="12">
                            Ngày hết hạn : <span style="color:red;">@EditModel.ExpiredDate.GetFormatDateWithMinute()</span>
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            Thời gian còn lại : <span style="color:red;">@EditModel.RemainingTime</span>
                        </AntDesign.Col>
                        <AntDesign.Col Span="24">
                            <div style="display:flex; align-items:center; gap:6px;">
                                <span>Trạng thái:</span>
                                @CommonTemplate.RenderReedemStatusText(EditModel.Status)
                            </div>
                        </AntDesign.Col>
                    </AntDesign.Row>
                </AntDesign.Col>
            </div>
            @if (EditModel.Status == RedeemCodeStatus.Used.ToString())
            {
                <div class="wrap_content">
                    <AntDesign.Col Span="24">
                        Người sử dụng : <span style="color:red;">@EditModel.RedeemedName</span>
                    </AntDesign.Col>
                    <AntDesign.Col Span="24">
                        Ngày sử dụng : <span style="color:red;">@EditModel.RedeemedDate.ToString()</span>
                    </AntDesign.Col>
                </div>
            }
        }
    </EditForm>
</Modal>


