@page "/user/wishlist"
@using AntDesign
@using static GameManagement.Share.Extension.EnumExtension
@using static GameManagement.Share.Extension.MessageEnumExtension
<div class="wishlist-page">

    <div class="wishlist-header">
        <h2>Danh sách yêu thích</h2>

        <div class="wishlist-count">
            @ViewModels.Count game
        </div>
    </div>

    <div class="wishlist-list">

        @foreach (var game in ViewModels)
        {
            <Card Class="wishlist-game-card">

                <div class="wishlist-game-content">

                    <!-- Ảnh -->
                    <div class="wishlist-game-image">
                        <img src="@($"{NavManager.BaseUri}{game.ImagePathView}")"
                             alt="@game.Name" />
                    </div>

                    <!-- Thông tin -->
                    <div class="wishlist-game-info">

                        <div class="wishlist-game-name">
                            <h3 style="color:white;">@game.Name</h3>
                        </div>

                        <div class="wishlist-game-meta">

                            @if (!string.IsNullOrEmpty(game.GameCompanyName))
                            {
                                <span>Hãng: @game.GameCompanyName</span>
                            }
                            <br />
                            <span>
                               Ngày phát hành: @game.ReleaseDate.ToString("dd/MM/yyyy")
                            </span>

                        </div>
                        <div class="wishlist-game-platform">
                            @if (game.SystemSupport == PlatformSystem.Window.ToString())
                            {
                                <Icon Type="windows" Theme="IconThemeType.Fill" />
                            }
                            else
                            {
                                <Icon Type="apple" Theme="IconThemeType.Fill" />
                            }
                        </div>

                        <div class="wishlist-game-tags">
                            @foreach (var type in game.TypeNames)
                            {
                                <Tag>
                                    @type
                                </Tag>
                            }
                        </div>

                    </div>

                    <!-- Giá + action -->
                    <div class="wishlist-game-actions">

                        <!-- Giá + Mua ngay -->
                        <div class="wishlist-purchase-row">

                            <div class="wishlist-price">
                                @if (game.CurrentSalePercent > 0)
                                {
                                    <div class="wishlist-sale">
                                        <span class="wishlist-discount">
                                            -@game.CurrentSalePercent%
                                        </span>

                                        <span class="wishlist-old-price">
                                            @game.DisplayPrice
                                        </span>
                                    </div>

                                    <div class="wishlist-current-price">
                                        @game.CurrentPrice
                                    </div>
                                }
                                else
                                {
                                    <div class="wishlist-current-price">
                                        @game.DisplayPrice
                                    </div>
                                }
                            </div>

                            <Button Type="ButtonType.Primary" Color="Color.Green6" OnClick="BuyGameAsync">
                                   
                                Mua ngay
                            </Button>

                        </div>

                        <!-- Thông tin wishlist -->
                        <div class="wishlist-meta-actions">

                            <span>
                                Thêm vào wishlist lúc @game.DateAddedWishlist.ToString("dd/MM/yyyy")
                            </span>

                            <Button Class="wishlist-remove"
                                    Type="ButtonType.Text"
                                    OnClick="() => RemoveGameAsync(game.Id)">
                                (Xóa)
                            </Button>

                        </div>

                    </div>

                </div>

            </Card>
        }

    </div>

</div>


