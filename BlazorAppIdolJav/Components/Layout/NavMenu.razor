@using AntDesign
@using static GameManagement.Share.Extension.EnumExtension
@inject NavigationManager Navigation

<Menu Mode="MenuMode.Vertical"
      Theme="MenuTheme.Dark"
      Class="admin-nav">

    <MenuItem Key="home">
        <NavLink href="/" Match="NavLinkMatch.All">
            <Icon Type="home" />
            <span>Trang chủ</span>
        </NavLink>
    </MenuItem>

    @if (HaveLogged)
    {
        if (IsAdmin)
        {
            <MenuItem Key="account">
                <NavLink href="">
                    <Icon Type="user" />
                    <span>Danh sách tài khoản</span>
                </NavLink>
            </MenuItem>
        }

        <MenuItem Key="game">
            <NavLink href="/danh-sach-game">
                <Icon Type="appstore" />
                <span>Danh sách Game</span>
            </NavLink>
        </MenuItem>

        if (IsAdmin)
        {
            <MenuItem Key="setup">
                <NavLink href="/thiet-lap-chung">
                    <Icon Type="setting" />
                    <span>Thiết lập</span>
                </NavLink>
            </MenuItem>
        }
    }

</Menu>