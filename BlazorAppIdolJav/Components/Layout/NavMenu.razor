@using AntDesign
@using static GameManagement.Share.Extension.EnumExtension
@inject NavigationManager Navigation

<Menu Mode="MenuMode.Vertical"
      Theme="MenuTheme.Dark"
      Class="admin-nav">

    <MenuItem Key="home">
        <NavLink href="/" Match="NavLinkMatch.All">
            <Icon Type="home" />
            <span>Trang chủ</span>
        </NavLink>
    </MenuItem>

    @if (HaveLogged)
    {
        if (IsAdmin)
        {
            <MenuItem Key="account">
                <NavLink href="/danh-sach-tai-khoan">
                    <Icon Type="user" />
                    <span>Quản lý tài khoản</span>
                </NavLink>
            </MenuItem>
        }

        if (IsAdmin)
        {
            <MenuItem Key="setup">
                <NavLink href="/danh-sach-ma-nap">
                    <Icon Type="gift" />
                    <span>Quản lý mã nạp</span>
                </NavLink>
            </MenuItem>
        }

        <MenuItem Key="game">
            <NavLink href="/danh-sach-game">
                <Icon Type="appstore" />
                @if (IsAdmin)
                {
                    <span>Quản lý Game</span>
                }
                else
                {
                    <span>Danh sách Game</span>
                }
            </NavLink>
        </MenuItem>
        if (IsAdmin)
        {
            <MenuItem Key="comment">
                <NavLink href="/danh-sach-binh-luan">
                    <Icon Type="comment" />
                    <span>Quản lý bình luận</span>
                </NavLink>
            </MenuItem>
        }
        if (IsAdmin)
        {
            <MenuItem Key="setup">
                <NavLink href="/thiet-lap-chung">
                    <Icon Type="setting" />
                    <span>Thiết lập chung</span>
                </NavLink>
            </MenuItem>
        }
    }

</Menu>