@page "/danh-sach-game"
@using AntDesign
@using GameManagement.CoreConfig.Extensions;
@using GameManagement.Share.Extension
@using GameManagement.Share.Model.ViewModel;
@using GameManagement.SpecialComponent;
@using GameManagement.WebInterface.User
@using Microsoft.AspNetCore.Components.Routing
@using static GameManagement.Share.Extension.EnumExtension


<AntDesign.Row Gutter="8">
    <AntDesign.Col Span="24">
        <AntDesign.Title Level="3">Danh sách game</AntDesign.Title>
    </AntDesign.Col>
    @if (isAdmin)
    {
        <AntDesign.Col Span="24">
            <Row Gutter="8">
                <Space>
                    <SpaceItem>
                        <Button Icon="plus" OnClick="@AddNewGame" Type="@ButtonType.Primary" Color="Color.Green7">Thêm mới</Button>
                    </SpaceItem>
                </Space>
            </Row>
        </AntDesign.Col>
        <AntDesign.Col Span="24">
            <Table TItem="GameViewModel"
                   DataSource="ViewModels"
                   ScrollX="1480px"
                   ScrollY="calc(100vh - 260px)"
                   ScrollBarWidth="@DefaultTableConfig.ScrollBarWidth"
                   Loading="loading"
                   OnRowClick="OnRowClick"
                   @ref="Table">

                <PropertyColumn Property="context => context.Stt"
                        Title="STT" Fixed="ColumnFixPlacement.Left"
                        Width="60">
                </PropertyColumn>

                <PropertyColumn Property="context => context.Name"
                        Title="Tên game" Fixed="ColumnFixPlacement.Left"
                        Width="200">
                </PropertyColumn>

                <PropertyColumn Property="context => context.GameCompanyName"
                        Title="Hãng game"
                        Width="150">
                </PropertyColumn>

                <PropertyColumn Property="context => context.Status"
                        Title="Trạng thái"
                        Width="120">
                    <Template>
                        @CommonTemplate.RenderGameStatusText(context.Status)
                    </Template>
                </PropertyColumn>

                <PropertyColumn Property="context => context.ReleaseStatus"
                        Title="Trạng thái phát hành"
                        Width="150">
                    <Template>
                        @CommonTemplate.RenderGameReleaseStatusText(context.ReleaseStatus)
                    </Template>
                </PropertyColumn>

                <PropertyColumn Property="context => context.SoldStatus"
                        Title="Trạng thái bán"
                        Width="120">
                    <Template>
                        @CommonTemplate.RenderGameSoldStatusText(context.SoldStatus)
                    </Template>
                </PropertyColumn>

                <PropertyColumn Property="context => context.TotalSold"
                        Title="Số lượng đã bán"
                        Width="100">
                    <Template>
                        <div class="sale-count-cell">
                            <span>@context.TotalSold</span>

                            <AntDesign.Tooltip Title="Xem lịch sử bán">
                                <span class="sale-history-icon">
                                    <Icon Type="clock-circle"
                                          Theme="IconThemeType.TwoTone" OnClick="() => ViewHistoryAsync(context.Name, context.Id)" />
                                </span>
                            </AntDesign.Tooltip>
                        </div>
                    </Template>
                </PropertyColumn>

                <PropertyColumn Property="context => context.TotalRevenue"
                        Width="130" Format="N0">
                    <TitleTemplate>
                        <Tooltip Title="Sẽ được tính theo tổng số tiền thực nhận khi bán , ko phải tính theo giá gốc">
                            <span>
                                Tổng doanh thu
                                <Icon Type="info-circle" />
                            </span>
                        </Tooltip>
                    </TitleTemplate>
                </PropertyColumn>

                <PropertyColumn Property="context => context.DisplayPrice"
                        Title="Giá gốc"
                        Width="130">
                </PropertyColumn>

                <PropertyColumn Property="context => context.CurrentSalePercent"
                        Width="140">
                    <TitleTemplate>
                        <Tooltip Title="Sẽ căn cứ theo giảm giá theo thời gian bên thiết lập, nếu không có mặc định là 0">
                            <span>
                                Giảm hiện tại (%)
                                <Icon Type="info-circle" />
                            </span>
                        </Tooltip>
                    </TitleTemplate>
                </PropertyColumn>

                <PropertyColumn Property="context => context.CurrentPrice"
                        Width="130">
                    <TitleTemplate>
                        <Tooltip Title="Giá hiện tại = Giá gốc * (100 - N%)/100">
                            <span>
                                Giá hiện tại
                                <Icon Type="info-circle" />
                            </span>
                        </Tooltip>
                    </TitleTemplate>
                </PropertyColumn>

                <PropertyColumn Property="context => context.IsFeatured"
                        Title="Game nổi bật"
                        Width="130">
                    <Template>
                        <Badge Count="@(context.OrderFeatured ?? 0)">
                            @if (context.IsFeatured)
                            {
                                <Tag>Có</Tag>
                            }
                            else
                            {
                                <Tag>Không</Tag>
                            }
                        </Badge>
                    </Template>
                </PropertyColumn>

                <ActionColumn Title="Thao tác"
                              Width="130" Fixed="ColumnFixPlacement.Right">
                    <Space Size="SpaceSize.Small">
                        <SpaceItem>
                            <Tooltip Title="Chi tiết">
                                <Button Type="ButtonType.Text"
                                        Size="ButtonSize.Default" Color="Color.Blue2"
                                        OnClick="() => ViewDetailAsync(context)">
                                    <Icon Type="eye" />
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="Xóa">
                                <Button Type="ButtonType.Text" Danger
                                        Size="ButtonSize.Default"
                                        OnClick="() => DeleteGameAsync(context)">
                                    <Icon Type="delete" />
                                </Button>
                            </Tooltip>
                        </SpaceItem>

                    </Space>
                </ActionColumn>

            </Table>

        </AntDesign.Col>
    }
    else
    {
        <div class="game-page">

            <GridRow Gutter="(16, 16)">
                @foreach (var game in ViewModels)
                {
                    <GridCol Xs="24"
                             Sm="12"
                             Md="12"
                             Lg="8"
                             Xl="6">

                        <Card Class="game-card">
                            <div class="game-card-content">
                                <!-- Ảnh game -->
                                <div class="game-image">
                                    <img src="@($"{NavManager.BaseUri}{game.ImagePathView}")"
                                         alt="@game.Name" />
                                </div>

                                <!-- Thông tin -->
                                <div class="game-info">

                                    <div class="game-name">
                                        @game.Name
                                    </div>

                                    <div class="game-review">

                                        <div class="review-info">
                                            <div>
                                                Tổng số đánh giá: <b>200</b>
                                            </div>

                                            <div>
                                                Đánh giá tích cực: <b>90%</b>
                                            </div>

                                            <div>
                                                Đánh giá tiêu cực: <b>10%</b>
                                            </div>
                                        </div>

                                        <div class="review-average">

                                            <div class="average-star">
                                                <span class="star active">★</span>
                                                <span class="star active">★</span>
                                                <span class="star active">★</span>
                                                <span class="star active">★</span>
                                                <span class="star half">
                                                    <span class="star-half-gray">★</span>
                                                    <span class="star-half-yellow">★</span>
                                                </span>
                                            </div>

                                            @* <div class="average-star">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= Math.Floor(game.AverageStar))
                                                    {
                                                        <span class="star active">★</span>
                                                    }
                                                    else if (i == Math.Ceiling(game.AverageStar) &&
                                                             game.AverageStar % 1 != 0)
                                                    {
                                                        <span class="star half">
                                                            <span class="star-half-yellow">★</span>
                                                            <span class="star-half-gray">★</span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="star">★</span>
                                                    }
                                                }
                                            </div> *@

                                            <div class="average-score-line">
                                                <span class="average-score">4.5</span>
                                                <span class="average-max">/ 5</span>
                                            </div>

                                            @if (game.IsPurchased)
                                            {
                                                <Button Type="ButtonType.Link"
                                                        Class="vote-button" OnClick="() => OpenVoteFormAsync(currentUserId, game.Id, game.Name)">
                                                    Đánh giá
                                                </Button>
                                            }

                                        </div>

                                    </div>

                                    <!-- Giá -->
                                    <div class="game-price-history">

                                        @if (game.CurrentSalePercent > 0)
                                        {
                                            <div>
                                                <span class="discount">
                                                    -@game.CurrentSalePercent%
                                                </span>

                                                <span class="old-price">
                                                    @game.DisplayPrice
                                                </span>
                                            </div>

                                            <div class="current-price-list">
                                                @game.CurrentPrice
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="current-price-list">
                                                @game.DisplayPrice
                                            </div>
                                        }
                                    </div>

                                    <!-- 3 nút -->
                                    <div class="game-actions">

                                        <Button Color="Color.Green6" OnClick="() => ViewDetailGameAsync(game.Id)" Class="detail-button">
                                            Xem chi tiết
                                        </Button>
                                        @if (game.RecentlyInWishlist)
                                        {
                                            <Tooltip Title="Xóa khỏi yêu thích">
                                                <Button Color="Color.Orange5" Class="wishlist-button"
                                                        OnClick="() => AddOrRemoveGameWishlistAsync(game.Id)">
                                                    x
                                                </Button>
                                            </Tooltip>
                                        }
                                        else
                                        {
                                            <Tooltip Title="Thêm vào yêu thích">
                                                <Button Color="Color.Magenta2" Class="wishlist-button"
                                                        OnClick="() => AddOrRemoveGameWishlistAsync(game.Id)">
                                                    ♡
                                                </Button>
                                            </Tooltip>
                                        }
                                        @if (game.IsPurchased)
                                        {
                                            <Button Disabled Class="purchased-button">
                                                ✓ Đã mua
                                            </Button>
                                        }
                                        else
                                        {
                                            <Button Type="ButtonType.Primary" OnClick="() => PurchaseGameNow(game)">
                                                Mua ngay
                                            </Button>
                                        }

                                    </div>

                                </div>
                            </div>

                        </Card>

                    </GridCol>
                }

            </GridRow>

        </div>

    }
</AntDesign.Row>

<Drawer Width="@width.ToString()" ZIndex="1000"
        Height="@height.ToString()"
        Visible="createVisible"
        Title="@title"
        OnClose="CloseDetailGame"
        MaskClosable="false">
    <GameDetail @ref="gameDetailRef" ReSize="ReSize" CompanyDatas="CompanyDatas" GameTypeDatas="GameTypeDatas"
                OnCancel="CloseDetailGame" ReloadGameData="LoadDataAsync" TotalCurrentFeatureGame="@totalFeature" FeatureDatas="FeatureGameDatas">

    </GameDetail>
</Drawer>

<Modal Title="Xác nhận mua game"
       @bind-Visible="isPurchaseModalVisible"
       OnOk="ConfirmPurchaseAsync"
       OkText="@confirmText"
       CancelText="@cancelText">

    @if (SelectedGame != null)
    {
        <div>
            <h5>@SelectedGame.Name</h5>

            <p>
                Bạn có chắc chắn muốn mua game này không? Sau khi thanh toán hoàn tất, game sẽ được thêm vào thư viện ngay lập tức
            </p>

            <p>
                Giá:
                <strong>
                    @SelectedGame.CurrentPrice
                </strong>
            </p>

            <div style="margin-top: 16px;">
                <div style="margin-bottom: 8px;">
                    <strong>Phương thức thanh toán</strong>
                </div>

                <RadioGroup TValue="string"
                            @bind-Value="PaymentMethod">

                    <Radio Value="@MethodPurchase.Wallet.ToString()">
                        @MethodPurchase.Wallet.GetDescription()
                    </Radio>

                    <Radio Value="@MethodPurchase.Banking.ToString()">
                        @MethodPurchase.Banking.GetDescription()
                    </Radio>

                </RadioGroup>
            </div>
        </div>
    }

</Modal>

<TransactionHistoryDetail @ref="transactionDetailRef"></TransactionHistoryDetail>

<GameReview @ref="reviewRef"></GameReview>