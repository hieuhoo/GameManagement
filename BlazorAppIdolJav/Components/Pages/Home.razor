@page "/"
@using AntDesign

<PageHeader Class="site-page-header">
</PageHeader>

<div class="steam-home">

    <!-- HERO -->
    <section class="steam-hero">

        <div class="steam-hero-overlay"></div>

        <div class="steam-hero-content">

            <span class="steam-label">
                NỀN TẢNG GAME TRỰC TUYẾN
            </span>

            <h1>
                Khám phá & quản lý kho game của bạn
            </h1>

            <p>
                Quản lý game, người dùng và thư viện cùng 1 chỗ.
            </p>

            <div class="steam-actions">

                <Button Type="ButtonType.Primary"
                        Size="ButtonSize.Default"
                        OnClick="HandleBrowseGame">

                    <Icon Type="appstore" />
                    Danh sách trò chơi

                </Button>
            </div>

        </div>

    </section>


    <!-- FEATURED -->
    <section class="steam-section">

        <div class="section-header">

            <div>
                <span class="section-subtitle">
                    KHÁM PHÁ
                </span>

                <h2>Game nổi bật</h2>
            </div>

            <a href="">
                Xem tất cả
            </a>

        </div>


        <div class="game-grid">

            @foreach (var game in FeaturedGames)
            {
                <div class="steam-game-card">

                    <div class="game-image"
                         style="background-image: url('@game.ImagePath')">

                        <span class="game-status">
                            NỔI BẬT
                        </span>

                        <div class="game-description-overlay">
                            <p>@game.Description</p>
                        </div>

                    </div>

                    <div class="game-info">

                        <h3>@game.Name</h3>
                        @if (game.DiscountPercent > 0)
                        {
                            <p>
                                Hạ giá sẽ hết sau @GetRemainingTime(game.DiscountEndDate)
                            </p>
                        }

                        <div class="game-footer">

                            <span class="game-company">
                                @game.CompanyName
                            </span>

                            <div class="game-price">

                                @if (game.DiscountPercent > 0)
                                {
                                    <span class="discount-badge">
                                        -@game.DiscountPercent%
                                    </span>

                                    <div class="price-detail">

                                        <span class="original-price">
                                            @game.Price.ToString("N0") @ConvertMoneyUnit(game.Unit)
                                        </span>

                                        <span class="current-price">
                                            @game.CurrentPrice.ToString("N0") @ConvertMoneyUnit(game.Unit)
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <span class="current-price">
                                        @game.Price.ToString("N0") @ConvertMoneyUnit(game.Unit)
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    </section>


    <!-- QUICK ACCESS -->
    <section class="steam-section">

        <div class="section-header">
            <div>
                <span class="section-subtitle">
                    QUẢN LÝ
                </span>

                <h2>Truy cập nhanh</h2>
            </div>
        </div>


        <div class="quick-grid">

            <div class="quick-card">

                <div class="quick-icon">
                    <Icon Type="appstore" />
                </div>

                <div>
                    <h3>Quản lý game</h3>
                    <p>Xem và quản lý kho game</p>
                </div>

            </div>


            <div class="quick-card">

                <div class="quick-icon">
                    <Icon Type="team" />
                </div>

                <div>
                    <h3>Quản lý tài khoản</h3>
                    <p>Quản lý người dùng cùng tài khoản</p>
                </div>

            </div>


            <div class="quick-card">

                <div class="quick-icon">
                    <Icon Type="bank" />
                </div>

                <div>
                    <h3>So sánh game</h3>
                    <p>Đối chiếu thông tin , số liệu</p>
                </div>

            </div>

        </div>

    </section>

</div>





