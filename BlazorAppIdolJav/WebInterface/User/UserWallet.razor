@page "/user/wallet"
@using AntDesign

<div class="wallet-page">
    <Title Level="2">
        Nạp tiền vào ví của bạn
    </Title>

    <div style="margin-bottom: 24px;">
        <Text Strong>Nạp tiền vào ví của bạn </Text>

        <div style="margin-top: 10px;">
            <Text>
                Số dư trong ví có thể được dùng để mua bất kỳ tựa game nào hoặc thực hiện giao dịch trong các trò chơi hỗ trợ thanh toán bằng ví.
            </Text>
        </div>

        <div style="margin-top: 8px;">
            <Text>
                Bạn sẽ có cơ hội xem lại đơn hàng trước khi tiến hành đặt mua.
            </Text>
        </div>
    </div>

    <AntDesign.Row Gutter="24">

        <AntDesign.Col Span="16">

            <Space Direction="SpaceDirection.Vertical" Style="width: 100%;" Size="SpaceSize.Middle">

                @foreach (var amount in WalletAmounts)
                {
                    <AntDesign.Card Class="wallet-fund-card">
                        <AntDesign.Row Align="RowAlign.Middle" Justify="RowJustify.SpaceBetween">
                            <AntDesign.Col>
                                <div class="wallet-amount">
                                    Nạp @amount.ToString("N0") VNĐ
                                </div>
                            </AntDesign.Col>
                            <AntDesign.Col>
                                <AntDesign.Space>
                                     <Input
                                        Value="@amount.ToString("N0")"
                                        ReadOnly="true"
                                        Style="width: 120px;" />

                                    <Button Type="ButtonType.Primary" OnClick="() => OpenTopUpForm(amount)">
                                        Nạp liền
                                    </Button>
                                </AntDesign.Space>
                            </AntDesign.Col>
                        </AntDesign.Row>
                    </AntDesign.Card>
                }
            </Space>

        </AntDesign.Col>

        <AntDesign.Col Span="8">

            <Card Title="Thông tin chung">

                <div class="wallet-balance">
                    <Text>Số dư ví</Text>

                    <span class="wallet-balance-value">
                        @currentBalance VNĐ
                    </span>
                </div>

                <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">

                    <Button Block OnClick="OpenRedeemModal">
                        Nhập mã code tiền hoặc game để add vào thư viện
                    </Button>

                </Space>

            </Card>

        </AntDesign.Col>

    </AntDesign.Row>

</div>

<Modal Title="Nhập mã code redeem"
       Visible="isRedeemModalVisible"
       Width="900"
       OnCancel="CloseRedeemForm"
       CancelText="@cancelText"
       OnOk="CloseRedeemForm">

    <Row Gutter="24">

        <Col Span="16">

        <Card>

            <Space Direction="SpaceDirection.Vertical"
                   Style="width: 100%;"
                   Size="SpaceSize.Middle">

                <Space>

                    <Input @bind-Value="redeemCode"
                           Placeholder="Nhập mã ở đây"
                           Style="width: 320px;" />

                    <Button Type="ButtonType.Primary" OnClick="() => EnterRedeemCodeAsync(redeemCode)">
                        Xác nhận
                    </Button>

                </Space>

                <Text Type="TextElementType.Secondary">
                    Nhập đi đợi chờ chi
                </Text>

            </Space>

        </Card>

    </Col>


    <Col Span="8">

    <Card Title="Tài khoản của bạn">

        <div class="redeem-balance">

            <Text>
                Số dư ví: 
            </Text>

            <span class="redeem-balance-value">
                @currentBalance VNĐ
            </span>

        </div>

    </Card>

</Col>

</Row>

</Modal>

<Modal Visible="topUpFormVisible"
       Title="Nạp tiền"
       Footer="@null" MaskClosable=true
       OnCancel="CloseTopUpForm">
    <Row>
        <Text>Số tiền nạp</Text>
    </Row>
    <br />
    <Row>
        <Input Type="@InputType.Text" @bind-Value="purchaseAmount" ReadOnly="true"/>
    </Row>
    <Row Gutter="8" Justify="@RowJustify.End">
        <Space>
            <SpaceItem>
                <Button Style="margin-top:20px;" Type="@ButtonType.Default" OnClick="() => CloseTopUpForm()">Hủy</Button>
            </SpaceItem>
            <SpaceItem>
                <Button Style="margin-top:20px;" HtmlType="submit" Type="@ButtonType.Primary" OnClick="() => PurchaseAsync(purchaseAmount)">Thanh toán</Button>
            </SpaceItem>
        </Space>
    </Row>
</Modal>






